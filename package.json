{
  "name": "my-electron-app",
  "version": "1.0.0",
  "private": true,
  "description": "Brain Anatomy Visualization Application with Local LLM",
  "author": "",
  "license": "ISC",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev:renderer": "vite --port 5173",
    "dev:preload": "node compile-preload.js",
    "dev:electron": "npm run dev:preload && wait-on http://localhost:5173 && electron electron-dev.cjs",
    "dev": "./start-dev.sh",
    "dev:legacy": "./run-dev.sh",
    "dev:js": "node start-dev.js",
    "dev:concurrent": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "prebuild": "chmod +x ./build-prep.sh && ./build-prep.sh",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.json --outDir dist/main-es && tsc-esm-fix --target='dist/main-es/**/*.js' && node scripts/convert-to-cjs.js",
    "build:electron:bundle": "NODE_ENV=production node bundle-main.js",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build": "npm run prebuild && npm run build:renderer && npm run build:electron && npm run build:preload && electron-builder",
    "build:bundle": "npm run prebuild && npm run build:renderer && npm run build:electron:bundle && npm run build:preload && electron-builder",
    "build:mac": "npm run prebuild && npm run build:renderer && npm run build:electron && npm run build:preload && electron-builder --mac",
    "build:mac:bundle": "npm run prebuild && npm run build:renderer && npm run build:electron:bundle && npm run build:preload && electron-builder --mac",
    "build:win": "npm run prebuild && npm run build:renderer && npm run build:electron && npm run build:preload && electron-builder --win",
    "build:win:bundle": "npm run prebuild && npm run build:renderer && npm run build:electron:bundle && npm run build:preload && electron-builder --win",
    "build:linux": "npm run prebuild && npm run build:renderer && npm run build:electron && npm run build:preload && electron-builder --linux",
    "build:linux:bundle": "npm run prebuild && npm run build:renderer && npm run build:electron:bundle && npm run build:preload && electron-builder --linux",
    "build:prototype": "chmod +x ./build-prototype.sh && ./build-prototype.sh",
    "start": "cross-env NODE_ENV=production electron .",
    "start:bundle": "NODE_ENV=production node start-bundled.js",
    "dev:bundle": "NODE_ENV=development concurrently \"npm run dev:renderer\" \"node bundle-main.js && node start-bundled.js\"",
    "db:init": "ts-node scripts/init-database.ts",
    "test": "vitest run",
    "test:fixed": "vitest run --config vitest.config.updated.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:encoder": "node src/test/encoder-test.js",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "fix:rollup": "chmod +x ./fix-rollup-native.sh && ./fix-rollup-native.sh",
    "fix:path": "chmod +x ./fix-electron-path.sh && ./fix-electron-path.sh",
    "fix:textencoder": "node fix-text-encoder.js",
    "postinstall": "electron-builder install-app-deps && npm install -D tsc-esm-fix",
    "fix:vite": "node fix-vite-config.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.2",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "dotenv": "^16.5.0",
    "draco": "^0.0.1",
    "electron-log": "^5.4.0",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.1.7",
    "leva": "^0.10.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.508.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.176.0",
    "winston": "^3.17.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@modelcontextprotocol/inspector": "^0.11.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.2.1",
    "@types/better-sqlite3": "^7.6.9",
    "@types/lodash": "^4.17.16",
    "@types/node": "^22.15.15",
    "@types/react": "^18.2.52",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^30.5.1",
    "electron-builder": "^26.0.12",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jest": "^29.7.0",
    "markdownlint-mcp-server": "^0.0.1-alpha.4",
    "node-llama-cpp": "^3.7.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^3.1.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.example.brainanatomyapp",
    "productName": "Brain Anatomy Visualizer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/assets/models",
        "to": "assets/models",
        "filter": [
          "**/*.glb"
        ]
      },
      {
        "from": "public/draco",
        "to": "draco"
      },
      {
        "from": "resources/llm-models",
        "to": "llm-models",
        "filter": [
          "**/*.gguf"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "",
        "repo": ""
      }
    ]
  }
}
