{
  "name": "brain-visualization-app",
  "version": "1.0.0",
  "description": "Interactive 3D brain visualization application",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -n vite,electron \"vite\" \"electron-forge start\"",
    "start": "electron-forge start",
    "build": "npm run build:electron && npm run build:renderer",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "analyze": "vite build --config vite.config.optimized.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@electron-forge/cli": "^6.0.0",
    "@types/node": "^18.11.18",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@types/three": "^0.149.0",
    "@typescript-eslint/eslint-plugin": "^5.51.0",
    "@typescript-eslint/parser": "^5.51.0",
    "@vitejs/plugin-react": "^3.1.0",
    "autoprefixer": "^10.4.13",
    "concurrently": "^7.6.0",
    "electron": "^23.0.0",
    "electron-builder": "^23.6.0",
    "eslint": "^8.33.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.21",
    "rollup-plugin-visualizer": "^5.9.0",
    "tailwindcss": "^3.2.7",
    "typescript": "^4.9.5",
    "vite": "^4.1.1",
    "vitest": "^0.28.5"
  },
  "dependencies": {
    "@react-three/drei": "^9.56.25",
    "@react-three/fiber": "^8.11.2",
    "lucide-react": "^0.112.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "three": "^0.149.0",
    "zustand": "^4.3.3"
  }
}